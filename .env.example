# ===========================================
# Aria Conductor - Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# --- LLM Provider (these are the DeepSeek values scripts/start.ps1 writes for its default preset) ---
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash

# --- OpenCode Sandbox (optional agent runtime; default provider is opencode) ---
# OpenSandbox server API key (leave empty for insecure local dev mode)
# OPENSANDBOX_API_KEY=
# OpenSandbox server URL for local dev (backend outside Docker connects to host port 8090)
# OPENCODE_SANDBOX_SERVER_URL=http://127.0.0.1:8090
# LLM API key injected into sandbox containers (for opencode agent runtime).
# Defaults to LLM_API_KEY if not set separately.
# DEEPSEEK_API_KEY=

# --- Operator authority ---
# Loopback deployments need no operator token: an anonymous request from
# 127.0.0.1/::1 is the local operator and the dashboard is authorized
# automatically. ARIA_OPERATOR_BEARER_TOKEN is CI/remote only (non-loopback
# deployments): a request that presents it as a Bearer credential is the
# operator. Generate a value unique to the deployment:
#   node -e "console.log('aria-'+require('crypto').randomBytes(16).toString('hex'))"
# ARIA_OPERATOR_BEARER_TOKEN=
# Proxied containerized deployments only: comma-separated exact peer addresses
# whose X-Forwarded-For is trusted (rightmost entry wins). Exact match only —
# no CIDR, no hostnames; a containerized proxy has a dynamic IP, so pin it
# before listing it here. Leave unset for loopback deployments.
# ARIA_OPERATOR_TRUSTED_PROXIES=

# --- Qoder core (Host mode) ---
# Absolute path of the pinned Qoder CLI (the bridge refuses a bare name it cannot
# resolve; the CLI of this machine is C:\Users\<user>\.qoder\bin\qodercli\qodercli.exe).
# ARIA_CORES_QODER_EXECUTABLE=
# Run pin of the Qoder model (default: efficient).
# ARIA_CORES_QODER_MODEL=efficient

# --- Database (MariaDB) ---
# IMPORTANT: change these credentials before any non-local deployment.
DB_ROOT_PASSWORD=change-me-root
DB_NAME=aria_conductor
DB_USER=aria
DB_PASSWORD=change-me

# --- Ports (optional) ---
# BACKEND_PORT=8080
# FRONTEND_PORT=3000
# OPENSANDBOX_PORT=8090

# --- Container Runtime (optional) ---
# docker | podman. Empty = the Linux/macOS .sh scripts auto-detect docker first, then podman;
# scripts/start.ps1 prefers podman whenever its CLI is present. An explicit value always wins.
# CONTAINER_RUNTIME=podman
# Host socket mounted into the OpenSandbox server for sandbox creation.
# Leave unset for Docker. For podman, scripts/start.ps1 fills this in automatically from
# `podman info` (rootless: /run/user/1000/podman/podman.sock, rootful: /run/podman/podman.sock).
# SANDBOX_SOCKET=

# --- Tool Configuration (optional) ---
# PROJECT_SOURCE=./agent-control-tower  # Mount project source for file tools (read-only in container)
# TOOLS_SHELL_ENABLED=true              # Enable unrestricted shell (default: whitelist-only mode)
# TOOLS_SHELL_WHITELIST=git,ls,cat,find,echo,mvn,npm,pnpm,curl  # Allowed commands when shell is not fully enabled

# --- Tool Pack / Git Integration (Issue #12) ---
# GitHub token for git push/PR creation by agents
# GITHUB_TOKEN=ghp_your-token-here
# AES-256 key for encrypting pack credentials at rest (32 chars recommended)
# PACK_CREDENTIAL_KEY=your-32-char-encryption-key-here
# Writable workspace root for per-run agent isolation
# TOOLS_FILE_WORKSPACE_DIR=/workspaces
