# ===========================================
# Aria Conductor - Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# --- LLM Provider ---
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o

# --- OpenCode Sandbox (optional agent runtime; default provider is langchain) ---
# OpenSandbox server API key (leave empty for insecure local dev mode)
# OPENSANDBOX_API_KEY=
# OpenSandbox server URL for local dev (backend outside Docker connects to host port 8090)
# OPENCODE_SANDBOX_SERVER_URL=http://localhost:8090
# LLM API key injected into sandbox containers (for opencode agent runtime).
# Defaults to LLM_API_KEY if not set separately.
# DEEPSEEK_API_KEY=

# --- Built-in API-key authentication (issue #1, /api/v1/**) ---
# When enabled, every /api/v1/** request must present a valid key via
# `Authorization: Bearer <key>` or `X-API-Key: <key>`. The mariadb (production) profile enables
# auth by default and REFUSES TO START without a key. Local dev (h2/default) stays open unless
# you opt in. Use a strong random value, or a `sha256:` hex digest of one (prefix entries with
# `sha256:`); separate multiple keys with commas. NEVER reuse the value you actually deploy in
# this example file.
# AUTH_API_KEYS=change-me-strong-api-key
# APP_SECURITY_ENABLED=false

# --- Database (MariaDB) ---
# IMPORTANT: change these credentials before any non-local deployment.
DB_ROOT_PASSWORD=change-me-root
DB_NAME=aria_conductor
DB_USER=aria
DB_PASSWORD=change-me

# --- Ports (optional) ---
# BACKEND_PORT=8080
# FRONTEND_PORT=3000
# ADK_PORT=9300
# OPENSANDBOX_PORT=8090

# --- Container Runtime (optional) ---
# docker | podman. Empty = auto-detect (docker preferred, podman fallback).
# CONTAINER_RUNTIME=podman
# Host socket mounted into the OpenSandbox server for sandbox creation.
# podman rootless: /run/user/1000/podman/podman.sock ; podman rootful: /run/podman/podman.sock
# SANDBOX_SOCKET=

# --- Tool Configuration (optional) ---
# PROJECT_SOURCE=./agent-control-tower  # Mount project source for file tools (read-only in container)
# TOOLS_SHELL_ENABLED=true              # Enable unrestricted shell (default: whitelist-only mode)
# TOOLS_SHELL_WHITELIST=git,ls,cat,find,echo,mvn,npm,pnpm,curl  # Allowed commands when shell is not fully enabled

# --- Tool Pack / Git Integration (Issue #12) ---
# GitHub token for git push/PR creation by agents
# GITHUB_TOKEN=ghp_your-token-here
# AES-256 key for encrypting pack credentials at rest (32 chars recommended)
# PACK_CREDENTIAL_KEY=your-32-char-encryption-key-here
# Writable workspace root for per-run agent isolation
# TOOLS_FILE_WORKSPACE_DIR=/workspaces
