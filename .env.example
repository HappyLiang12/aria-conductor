# ===========================================
# Aria Conductor - Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# --- LLM Provider ---
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o

# --- Database (MariaDB) ---
# IMPORTANT: change these credentials before any non-local deployment.
DB_ROOT_PASSWORD=change-me-root
DB_NAME=aria_conductor
DB_USER=aria
DB_PASSWORD=change-me

# --- Ports (optional) ---
# BACKEND_PORT=8080
# FRONTEND_PORT=3000
# ADK_PORT=9300
