{
  "components": {
    "schemas": {
      "Context": {
        "description": "RBAC and session context -- passed fresh each round by Control Tower.\n\nThis is the extension point for future RBAC enforcement.\nCurrently passed as an empty object by Control Tower.",
        "properties": {
          "access_level": {
            "default": "operator",
            "title": "Access Level",
            "type": "string"
          },
          "allowed_tools": {
            "items": {
              "type": "string"
            },
            "title": "Allowed Tools",
            "type": "array"
          },
          "session_carryover": {
            "additionalProperties": true,
            "title": "Session Carryover",
            "type": "object"
          }
        },
        "title": "Context",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Message": {
        "description": "A single message in the conversation history.",
        "properties": {
          "content": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Message text content",
            "title": "Content"
          },
          "role": {
            "description": "system | user | assistant | tool",
            "title": "Role",
            "type": "string"
          },
          "tool_call_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "ID of the tool call this message responds to",
            "title": "Tool Call Id"
          },
          "tool_calls": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/ToolCall"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "Tool calls made by the assistant",
            "title": "Tool Calls"
          }
        },
        "required": [
          "role"
        ],
        "title": "Message",
        "type": "object"
      },
      "RunRequest": {
        "description": "POST /run request body \u2014 fully self-contained, no server-side state.",
        "properties": {
          "agent_id": {
            "title": "Agent Id",
            "type": "string"
          },
          "context": {
            "$ref": "#/components/schemas/Context"
          },
          "llm_api_key": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Per-request LLM API key (overrides env)",
            "title": "Llm Api Key"
          },
          "llm_base_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Per-request LLM base URL (overrides env)",
            "title": "Llm Base Url"
          },
          "max_tokens": {
            "default": 1024,
            "title": "Max Tokens",
            "type": "integer"
          },
          "messages": {
            "items": {
              "$ref": "#/components/schemas/Message"
            },
            "title": "Messages",
            "type": "array"
          },
          "model": {
            "default": "deepseek-chat",
            "title": "Model",
            "type": "string"
          },
          "session_id": {
            "default": "",
            "title": "Session Id",
            "type": "string"
          },
          "temperature": {
            "default": 0.7,
            "title": "Temperature",
            "type": "number"
          },
          "tools": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Tools",
            "type": "array"
          }
        },
        "required": [
          "agent_id"
        ],
        "title": "RunRequest",
        "type": "object"
      },
      "ToolCall": {
        "description": "A tool/function call made by the LLM.",
        "properties": {
          "arguments": {
            "title": "Arguments",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "arguments"
        ],
        "title": "ToolCall",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "LangChain ADK",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "description": "Liveness probe \u2014 called by Control Tower health checks.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/run": {
      "post": {
        "description": "Execute the agent for one round. Returns an SSE stream of events.\n\nEvent types: status, thinking, tool_call, tool_result, response, error, done",
        "operationId": "run_run_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RunRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Run"
      }
    },
    "/status/{agent_id}": {
      "get": {
        "description": "Return the current state of an agent (idle/running/thinking/error).",
        "operationId": "status_status__agent_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "agent_id",
            "required": true,
            "schema": {
              "title": "Agent Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Status"
      }
    }
  }
}