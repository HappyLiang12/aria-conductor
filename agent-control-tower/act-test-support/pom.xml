<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.aria.conductor</groupId>
        <artifactId>agent-control-tower</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>act-test-support</artifactId>
    <name>ACT Test Support</name>
    <description>
        Shared test utilities (fluent builders, mock clients, assertion helpers,
        integration base class). Published with compile scope so other modules can
        depend on it from their test scope without re-declaring transitive deps.
    </description>

    <dependencies>
        <!-- Access entity types and enums -->
        <dependency>
            <groupId>io.aria.conductor</groupId>
            <artifactId>act-common</artifactId>
        </dependency>

        <!-- Spring Boot test stack (compile scope so dependents inherit it) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>compile</scope>
            <exclusions>
                <exclusion>
                    <groupId>org.junit.vintage</groupId>
                    <artifactId>junit-vintage-engine</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- Mockito (already pulled in by starter-test, declared explicitly per spec) -->
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <scope>compile</scope>
        </dependency>

        <!-- H2 for in-memory integration tests -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>compile</scope>
        </dependency>

        <!-- Awaitility (used by IntegrationTestBase consumers for async assertions) -->
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <scope>compile</scope>
        </dependency>

        <!-- Spring Boot data JPA (needed for @Transactional + IntegrationTestBase) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
            <scope>compile</scope>
        </dependency>
    </dependencies>
</project>

