Hibernate: create table approvals (decided_at timestamp(6) with time zone, expires_at timestamp(6) with time zone, requested_at timestamp(6) with time zone not null, id UUID not null, knowledge_item_id UUID, run_id uuid not null, tool_call_id uuid, kanban_item_id varchar(36), answer TEXT, content TEXT, context_md TEXT, options_json TEXT, reason varchar(255), approval_type enum ('SPEC_REVIEW','TOOL_CALL') not null, ask_type enum ('APPROVAL','QUESTION','REVIEW_REQUEST') not null, content_kind enum ('HTML','MARKDOWN'), source enum ('ACP_PERMISSION','LEGACY_GATE') not null, status enum ('APPROVED','DENIED','EXPIRED','PENDING') not null, primary key (id))
Hibernate: create table audit_log (created_at timestamp(6) with time zone not null, id bigint generated by default as identity, conversation_id varchar(36), action varchar(255) not null, details TEXT, event_type varchar(255) not null, resource_id varchar(255), resource_type varchar(255) not null, primary key (id))
Hibernate: create table dod_records (created_at timestamp(6) with time zone, updated_at timestamp(6) with time zone, current_stage varchar(20) not null, overall_status varchar(20) not null, id varchar(36) not null, task_id varchar(36) not null unique, task_type varchar(50), stages_json TEXT, primary key (id))
